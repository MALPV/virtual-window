{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Virtual Window",
  "version": "0.1.0",
  "identifier": "dev.marcos.virtualwindow",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Virtual Window",
        "width": 300,
        "height": 400,
        "minWidth": 180,
        "minHeight": 220,
        "center": true,
        "resizable": true,
        "maximizable": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:",
      "devCsp": "default-src 'self' ipc: http://ipc.localhost ws://localhost:1420 ws://localhost:1421; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
